# Port the server listens on
PORT=3000

# Public base URL, used to build the OAuth redirect (no trailing slash)
PUBLIC_URL=http://localhost:3000

# Discord sign-in. Create an app at https://discord.com/developers/applications
# and add ${PUBLIC_URL}/auth/discord/callback as a redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=

# Comma-separated usernames that get admin tools (reports, gold checks)
ADMIN_USERNAMES=

# Roblox Open Cloud OAuth 2.0 app credentials (required for organisation verification)
# Create the app at https://create.roblox.com/dashboard/credentials
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Optional override. Defaults to ${PUBLIC_URL}/auth/roblox/callback
# ROBLOX_REDIRECT_URI=
