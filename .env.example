# Port the server listens on
PORT=3000

# Public base URL, used to build the OAuth redirect (no trailing slash)
PUBLIC_URL=http://localhost:3000

# Roblox Open Cloud OAuth 2.0 app credentials (required for airline verification)
# Create the app at https://create.roblox.com/dashboard/credentials
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Optional override. Defaults to ${PUBLIC_URL}/auth/roblox/callback
# ROBLOX_REDIRECT_URI=
