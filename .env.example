# Server
HOST=127.0.0.1
PORT=3000
API_KEY=
# Set to 1 only if you intentionally want a non-loopback server without API auth.
ALLOW_UNAUTHENTICATED=0

# Browser
HEADLESS=0
USE_REAL_CHROME=1
CHROME_PATH=
CHROME_USER_DATA_DIR=
CHROME_PROFILE=
NO_SANDBOX=0
PROFILE_ROOT=./profiles
TMP_ROOT=./profiles/.tmp

# Linux VPS: the setup guide uses this virtual display.
DISPLAY=:99

# Reliability
TIMEOUT=180000
AUTO_RECOVER=1
RECOVERY_RETRIES=1
STREAM_POLL_MS=120
STREAM_STABLE_MS=1300

# Models
MODEL_STRICT=0
MODEL_SELECT_TIMEOUT=6500
AUTO_DISCOVER_MODELS=1
MODEL_DISCOVERY_TTL_MS=600000
MODEL_MAP=

# Images
BODY_LIMIT=50mb
MAX_IMAGES=10
MAX_IMAGE_BYTES=20971520

# Optional automatic tool execution
TOOL_ENDPOINT=
TOOL_SECRET=
MAX_TOOL_LOOPS=8

# Optional provider URL overrides
CHATGPT_URL=https://chatgpt.com/?temporary-chat=true
GEMINI_URL=https://gemini.google.com/app
CLAUDE_URL=https://claude.ai/new
GROK_URL=https://grok.com/
DEEPSEEK_URL=https://chat.deepseek.com/
