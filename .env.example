# Server
HOST=127.0.0.1
PORT=3000
API_KEY=
# Set to 1 only if you intentionally want a non-loopback server without API auth.
ALLOW_UNAUTHENTICATED=0

# Multi-account
# One-line JSON. "default" remains compatible with existing profiles/<provider> directories.
ACCOUNTS={"chatgpt":["default"],"gemini":["default"],"claude":["default"],"grok":["default"],"deepseek":["default"]}
# Optional provider -> default account mapping, e.g. {"chatgpt":"plus2","claude":"team"}
DEFAULT_ACCOUNTS={}
# Allow API/CLI account IDs not pre-listed in ACCOUNTS.
ALLOW_DYNAMIC_ACCOUNTS=0

# Auto account routing
# When 1, requests without an explicit account automatically choose among configured accounts.
# "account":"auto" or X-GPTWrap-Account: auto forces auto routing for that request.
AUTO_ROUTE_ACCOUNTS=1
# least-load = fewest active requests, then least recently selected. round-robin = simple rotation.
ROUTER_STRATEGY=least-load
# Health failures temporarily remove an account from auto selection. 429/usage-limit responses do not trigger this.
ROUTER_FAILURE_COOLDOWN_MS=60000

# Private localhost ports used by per-account child gptwrap engines.
CHILD_PORT_BASE=3100
# Max time to wait for a child engine to become healthy.
CHILD_START_TIMEOUT=30000
# 0 keeps a used child running. Set e.g. 600000 to stop an idle account after 10 minutes.
CHILD_IDLE_MS=0

# Browser
HEADLESS=0
USE_REAL_CHROME=1
CHROME_PATH=
# External Chrome profile is only compatible with the default gptwrap account.
CHROME_USER_DATA_DIR=
CHROME_PROFILE=
NO_SANDBOX=0
PROFILE_ROOT=./profiles
TMP_ROOT=./profiles/.tmp

# Linux VPS virtual display
DISPLAY=:99

# Reliability
TIMEOUT=180000
AUTO_RECOVER=1
RECOVERY_RETRIES=1
STREAM_POLL_MS=120
STREAM_STABLE_MS=1300

# Models
MODEL_STRICT=0
MODEL_SELECT_TIMEOUT=6500
AUTO_DISCOVER_MODELS=1
MODEL_DISCOVERY_TTL_MS=600000
MODEL_MAP=

# Images
BODY_LIMIT=50mb
MAX_IMAGES=10
MAX_IMAGE_BYTES=20971520

# Optional automatic tool execution
TOOL_ENDPOINT=
TOOL_SECRET=
MAX_TOOL_LOOPS=8

# Optional provider URL overrides
CHATGPT_URL=https://chatgpt.com/?temporary-chat=true
GEMINI_URL=https://gemini.google.com/app
CLAUDE_URL=https://claude.ai/new
GROK_URL=https://grok.com/
DEEPSEEK_URL=https://chat.deepseek.com/