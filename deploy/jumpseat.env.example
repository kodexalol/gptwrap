# Jumpseat production settings. setup.sh copies this to /etc/jumpseat.env (mode 600, root only).
# Never add ALLOW_DEV_LOGIN here: production must not offer test sign-in.

NODE_ENV=production
PORT=3000

# Public address, https, no trailing slash. Sets the OAuth redirect URIs and secure cookies.
PUBLIC_URL=https://your-domain.example

# Comma-separated usernames that get admin tools.
ADMIN_USERNAMES=

# Discord sign-in. Redirect URI: ${PUBLIC_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Roblox OAuth app. Redirect URI: ${PUBLIC_URL}/auth/roblox/callback
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
